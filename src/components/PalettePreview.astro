<details class="palette-lab" open>
  <summary>Contrasto <span>Anteprima locale</span></summary>
  <div class="palette-lab-body">
    <p>Confronta il fondo intermedio con un nero più netto e dettagli rossi.</p>
    <button type="button" data-palette-choice="medium" aria-pressed="false"><span class="swatches"><i style="background:#9c9c98"></i><i style="background:#e7e7e2"></i><i style="background:#e25146"></i></span><span><strong>Intermedia</strong><small>Fondo pietra e schede chiare</small></span></button>
    <button type="button" data-palette-choice="dark" aria-pressed="false"><span class="swatches"><i style="background:#08090a"></i><i style="background:#e5e5e1"></i><i style="background:#e25146"></i></span><span><strong>Nero e rosso</strong><small>Accenti Nemesis e schede chiare</small></span></button>    <p class="palette-note">La scelta cambia solo questa anteprima.</p>
  </div>
</details>
<script>
  const choices = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-palette-choice]'));
  function selectPalette(palette: string) {
    document.documentElement.dataset.previewPalette = palette;
    choices.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.paletteChoice === palette)));
    try { sessionStorage.setItem('cesare-preview-palette', palette); } catch {}
  }
  const current = document.documentElement.dataset.previewPalette ?? 'medium';
  selectPalette(current);
  choices.forEach(button => button.addEventListener('click', () => selectPalette(button.dataset.paletteChoice!)));
</script>
<style>
  .palette-lab { position: fixed; z-index: 70; bottom: 18px; right: 18px; width: 300px; max-width: calc(100vw - 36px); background: #f7f4ef; color: #252320; border: 1px solid #c9c3b8; border-radius: 12px; box-shadow: 0 8px 40px #0004; font: 13px/1.5 Inter, sans-serif; }
  summary { padding: 13px 16px; cursor: pointer; font-weight: 600; list-style: none; display: flex; justify-content: space-between; align-items: center; }
  summary::-webkit-details-marker { display: none; }
  summary span { font-size: 10px; font-weight: 400; text-transform: uppercase; letter-spacing: .07em; color: #655f56; }
  .palette-lab-body { padding: 0 12px 12px; }
  p { padding: 0 4px; margin-bottom: 12px; color: #655f56; font-size: 11px; }
  button { width: 100%; display: flex; align-items: center; gap: 12px; text-align: left; padding: 11px 9px; margin-bottom: 6px; border: 1px solid #d4cec3; border-radius: 7px; background: transparent; color: #252320; }
  button[aria-pressed='true'] { background: #e9e5dd; border: 2px solid #524d43; padding: 10px 8px; }
  strong { display: block; font-size: 12px; }
  small { display: block; color: #655f56; font-size: 10px; margin-top: 2px; }
  .swatches { display: flex; flex-shrink: 0; }
  i { width: 17px; height: 28px; display: block; border: 1px solid #0002; }
  i:first-child { border-radius: 4px 0 0 4px; }
  i:last-child { border-radius: 0 4px 4px 0; }
  .palette-note { font-size: 10px; margin: 10px 0 0; }
</style>
