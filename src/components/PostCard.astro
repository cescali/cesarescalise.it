---
import type { WPPost } from '../lib/wordpress';
import { formatDate, getFeaturedImage, stripHtml } from '../lib/wordpress';

interface Props {
  post: WPPost;
}
const { post } = Astro.props;
const image = getFeaturedImage(post);
const excerpt = stripHtml(post.excerpt.rendered).slice(0, 160);
---

<article class="group flex flex-col sm:flex-row gap-5 py-6 border-b border-gray-100 last:border-0">
  {image && (
    <a href={`/blog/${post.slug}`} class="flex-shrink-0">
      <img
        src={image}
        alt={post.title.rendered}
        class="w-full sm:w-44 h-32 object-cover rounded-lg group-hover:opacity-90 transition-opacity"
        loading="lazy"
      />
    </a>
  )}
  <div class="flex flex-col justify-center">
    <time class="text-xs text-gray-400 mb-1">{formatDate(post.date)}</time>
    <a href={`/blog/${post.slug}`}>
      <h2
        class="text-lg font-semibold leading-snug group-hover:text-blue-600 transition-colors mb-2"
        set:html={post.title.rendered}
      />
    </a>
    <p class="text-sm text-gray-500 leading-relaxed">{excerpt}…</p>
    <a
      href={`/blog/${post.slug}`}
      class="mt-3 text-sm font-medium text-blue-600 hover:underline self-start"
    >
      Leggi →
    </a>
  </div>
</article>
