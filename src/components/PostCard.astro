---
import type { WPPost } from '../lib/wordpress';
import { formatDate, getFeaturedImage, stripHtml } from '../lib/wordpress';

interface Props {
  post: WPPost;
}
const { post } = Astro.props;
const image   = getFeaturedImage(post);
const excerpt = stripHtml(post.excerpt.rendered).slice(0, 120);
---

<article class="group flex flex-col rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition-shadow duration-300 bg-white">
  <a href={`/blog/${post.slug}`} class="block overflow-hidden">
    {image ? (
      <div class="relative aspect-[3/2] overflow-hidden bg-gray-100">
        <img
          src={image}
          alt={post.title.rendered}
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
          loading="lazy"
        />
        <div class="absolute top-3 left-3">
          <time class="text-xs font-semibold bg-indigo-600 text-white px-2.5 py-1 rounded-full shadow">
            {formatDate(post.date)}
          </time>
        </div>
      </div>
    ) : (
      <div class="aspect-[3/2] bg-gradient-to-br from-indigo-50 to-indigo-100 flex items-center justify-center">
        <span class="text-gray-600 text-5xl">✒️</span>
      </div>
    )}
  </a>

  <div class="p-5 flex flex-col flex-grow">
    {!image && (
      <time class="text-xs font-semibold text-indigo-600 mb-2 block">{formatDate(post.date)}</time>
    )}
    <a href={`/blog/${post.slug}`}>
      <h2
        class="font-display text-xl font-bold leading-snug group-hover:text-indigo-600 transition-colors mb-3 line-clamp-3"
        set:html={post.title.rendered}
      />
    </a>
    <p class="text-sm text-gray-500 leading-relaxed flex-grow line-clamp-3">{excerpt}…</p>
    <a
      href={`/blog/${post.slug}`}
      class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-indigo-600 hover:text-indigo-700 transition-colors self-start"
    >
      Leggi l'articolo →
    </a>
  </div>
</article>
