---
import ArrowIcon from './ArrowIcon.astro';
interface Props {
  label: string;
  applications: { href: string; label: string }[];
  isEnglish?: boolean;
  mobile?: boolean;
}
const { label, applications, isEnglish = false, mobile = false } = Astro.props;
---
<details class:list={['applications-menu', { 'applications-menu--mobile': mobile }]}>
  <summary>{label}<svg class="applications-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="m3 4.5 3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></summary>
  <ul class="applications-links" aria-label={label}>
    {applications.map(app => (
      <li><a href={app.href} target="_blank" rel="noopener noreferrer" aria-label={app.label + (isEnglish ? ' (opens in a new tab)' : ' (si apre in una nuova scheda)')}>{app.label}<ArrowIcon /></a></li>
    ))}
  </ul>
</details>

<style>
  .applications-menu { position: relative; }
  .applications-menu summary { display: inline-flex; align-items: center; gap: .45rem; cursor: pointer; list-style: none; color: #b8bec8; padding-bottom: .125rem; transition: color .18s; }
  .applications-menu summary::-webkit-details-marker { display: none; }
  .applications-menu summary:hover, .applications-menu[open] > summary { color: #e2c38a; }
  .applications-menu summary:focus-visible, .applications-links a:focus-visible { outline: 2px solid #e2c38a; outline-offset: 5px; border-radius: 3px; }
  .applications-chevron { transition: transform .18s; }
  .applications-menu[open] > summary .applications-chevron { transform: rotate(180deg); }
  .applications-links { position: absolute; right: 0; top: calc(100% + .9rem); z-index: 60; min-width: 215px; padding: .5rem; margin: 0; list-style: none; border: 1px solid #35383e; border-radius: 12px; background: #17191d; box-shadow: 0 12px 32px #0005; }
  .applications-links li { margin: 0; padding: 0; }
  .applications-links a { display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: .8rem .9rem; border-radius: 7px; color: #e6e8ec; text-decoration: none; font-size: .875rem; white-space: nowrap; }
  .applications-links a:hover { background: #25282e; color: #e2c38a; }
  .applications-links :global(svg) { flex-shrink: 0; opacity: .75; }
  .applications-menu--mobile summary { display: flex; width: 100%; min-height: 48px; padding: .75rem 0; }
  .applications-menu--mobile .applications-links { position: static; min-width: 0; width: 100%; margin: 0 0 .7rem; box-shadow: none; }
  @media (prefers-reduced-motion: reduce) { .applications-menu summary, .applications-chevron { transition: none; } }
</style>

<script>
  document.querySelectorAll<HTMLDetailsElement>('.applications-menu').forEach(menu => {
    menu.addEventListener('toggle', () => {
      if (menu.open) document.querySelectorAll<HTMLDetailsElement>('.applications-menu').forEach(other => { if (other !== menu) other.open = false; });
    });
    menu.querySelectorAll('a').forEach(link => link.addEventListener('click', () => { menu.open = false; }));
  });
  document.addEventListener('click', event => {
    document.querySelectorAll<HTMLDetailsElement>('.applications-menu[open]').forEach(menu => {
      if (event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
    });
  });
  document.addEventListener('keydown', event => {
    if (event.key !== 'Escape') return;
    document.querySelectorAll<HTMLDetailsElement>('.applications-menu[open]').forEach(menu => {
      const restoreFocus = menu.contains(document.activeElement);
      menu.open = false;
      if (restoreFocus) menu.querySelector('summary')?.focus();
    });
  });
</script>
