---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import GalleryCard from '../components/GalleryCard.astro';
import { getPosts } from '../lib/wordpress';
import { getFolders } from '../lib/cloudinary';
import type { WPPost } from '../lib/wordpress';
import type { CldFolder } from '../lib/cloudinary';

let posts: WPPost[]    = [];
let galleries: CldFolder[] = [];

try {
  [posts, galleries] = await Promise.all([getPosts(6), getFolders()]);
} catch (err) {
  console.error('[Home] data loading error:', err);
  // tenta singolarmente
  try { posts     = await getPosts(6);    } catch {}
  try { galleries = await getFolders();   } catch {}
}

const latestGalleries = galleries.slice(0, 3);

const socials = [
  { name: 'Instagram', url: 'https://www.instagram.com/cesarescalise.it/',          icon: 'instagram' },
  { name: 'Facebook',  url: 'https://www.facebook.com/cesare.scalise?locale=it_IT', icon: 'facebook' },
  { name: 'Threads',   url: 'https://www.threads.com/@cesarescalise.it',            icon: 'threads' },
  { name: 'X',         url: 'https://x.com/cescali',                                icon: 'x' },
  { name: 'LinkedIn',  url: 'https://www.linkedin.com/in/cesare-scalise-0283858/',  icon: 'linkedin' },
];
---

<BaseLayout title="Home">

  <!-- Hero -->
  <section class="bg-gradient-to-br from-indigo-50 via-white to-white pt-14 pb-[90px] px-5">
    <div class="max-w-6xl mx-auto text-center">
      <p class="text-indigo-600 font-semibold text-sm uppercase tracking-widest mb-5">Benvenuto nel mio spazio</p>
      <h1 class="font-display text-5xl sm:text-6xl lg:text-7xl font-bold mb-6 leading-tight text-gray-900">
        Ciao, sono<br class="2xl:hidden"/>
        <span class="2xl:ml-4 text-indigo-600">Cesare Scalise</span>
      </h1>
      <p class="text-lg text-gray-500 max-w-2xl mx-auto mb-10 leading-relaxed">
        Scrivo del mio lavoro, delle mie passioni e condivido foto dei miei viaggi e avventure.
      </p>
      <div class="flex gap-4 justify-center flex-wrap">
        <a href="/blog"
           class="px-7 py-3 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-semibold transition-colors shadow-md">
          Blog
        </a>
        <a href="/gallerie"
           class="px-7 py-3 border-2 border-gray-300 hover:border-indigo-500 hover:text-indigo-600 text-gray-700 rounded-xl font-semibold transition-colors">
          Gallerie foto
        </a>
        <a href="/libri"
           class="px-7 py-3 border-2 border-gray-300 hover:border-indigo-500 hover:text-indigo-600 text-gray-700 rounded-xl font-semibold transition-colors">
          Libri
        </a>
        <a href="/cv"
           class="px-7 py-3 border-2 border-gray-300 hover:border-indigo-500 hover:text-indigo-600 text-gray-700 rounded-xl font-semibold transition-colors">
          Il mio CV
        </a>
      </div>

      <div class="flex gap-4 justify-center mt-10">
        {socials.map(s => (
          <a
            href={s.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={s.name}
            class="w-11 h-11 flex items-center justify-center rounded-full border-2 border-gray-200 hover:border-indigo-500 transition-colors"
          >
            <img src={`https://cdn.jsdelivr.net/npm/simple-icons@v13/icons/${s.icon}.svg`} alt={s.name} class="w-5 h-5 opacity-60" loading="lazy" />
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Ultimi articoli -->
  <section class="max-w-6xl mx-auto px-5 pt-[51px] pb-16">
    <div class="flex items-end justify-between mb-10">
      <div>
        <p class="text-indigo-600 text-sm font-semibold uppercase tracking-widest mb-1">Dal blog</p>
        <h2 class="font-display text-3xl sm:text-4xl font-bold">Ultimi articoli</h2>
      </div>
      <a href="/blog" class="text-sm font-semibold text-gray-400 hover:text-indigo-600 transition-colors hidden sm:block">
        Tutti gli articoli →
      </a>
    </div>
    {posts.length === 0 ? (
      <p class="text-gray-400">Nessun articolo trovato.</p>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4 gap-6">
        {posts.map(post => <PostCard post={post} />)}
      </div>
    )}
    <div class="mt-8 sm:hidden">
      <a href="/blog" class="text-sm font-semibold text-indigo-600">Tutti gli articoli →</a>
    </div>
  </section>

  <!-- Gallerie -->
  {latestGalleries.length > 0 && (
    <section class="bg-gray-50 py-16 px-5">
      <div class="max-w-6xl mx-auto">
        <div class="flex items-end justify-between mb-10">
          <div>
            <p class="text-indigo-600 text-sm font-semibold uppercase tracking-widest mb-1">Fotografia</p>
            <h2 class="font-display text-3xl sm:text-4xl font-bold">Gallerie</h2>
          </div>
          <a href="/gallerie" class="text-sm font-semibold text-gray-400 hover:text-indigo-600 transition-colors hidden sm:block">
            Tutte le gallerie →
          </a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4 gap-6">
          {latestGalleries.map(g => <GalleryCard gallery={g} />)}
        </div>
      </div>
    </section>
  )}

</BaseLayout>
