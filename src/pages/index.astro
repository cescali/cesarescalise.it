---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookCarousel from '../components/BookCarousel.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import PostCard from '../components/PostCard.astro';
import GalleryCard from '../components/GalleryCard.astro';
import { getPosts, getPage, getFeaturedImage } from '../lib/wordpress';
import { getFolders } from '../lib/cloudinary';
import '../styles/home.css';

// Le fonti sono indipendenti: un servizio non disponibile non nasconde gli altri contenuti.
const [postResult, galleryResult, bookResult] = await Promise.allSettled([
  getPosts(3), getFolders(), getPage('libri'),
]);
const posts = postResult.status === 'fulfilled' ? postResult.value : [];
const galleries = galleryResult.status === 'fulfilled' ? galleryResult.value.slice(0, 4) : [];
const bookHtml = bookResult.status === 'fulfilled' ? bookResult.value?.content.rendered ?? '' : '';
const italianCover = bookHtml.match(/<img\b[^>]*\bsrc="([^"]+)"/)?.[1]
  ?? 'https://www.cesarescalise.it/wordpress/wp-content/uploads/2026/10/Progetto_Nemesis_Kindle_Cover-663x1024.jpg';
const backdropPost = posts.find(post => post.slug.includes('una-nave-puo'));
const backdrop = backdropPost ? getFeaturedImage(backdropPost) ?? '/images/books/project-nemesis.webp' : '/images/books/project-nemesis.webp';
const englishBackdropPost = posts.find(post => post.slug.includes('cole-vance'));
const englishBackdrop = englishBackdropPost ? getFeaturedImage(englishBackdropPost) ?? '/images/books/project-nemesis.webp' : '/images/books/project-nemesis.webp';
const editions = [
  { id: 'it', language: 'it', title: 'Progetto Nemesis', headline: 'Il nemico è già a bordo.', cover: italianCover, backdrop,
    description: 'Una minaccia invisibile. Le rotte del mondo. Una corsa contro il tempo tra spionaggio, sabotaggi navali e operazioni clandestine.',
    page: '/libri/', amazon: 'https://www.amazon.it/dp/B0HLXTBMK1', discover: 'Scopri il romanzo', buy: 'Acquista su Amazon' },
  { id: 'en', language: 'en', title: 'Project Nemesis', headline: 'The enemy is already on board.', cover: '/images/books/project-nemesis.webp', backdrop: englishBackdrop,
    description: 'An invisible threat. The world’s shipping routes. A race against time through espionage, naval sabotage, and covert operations.',
    page: '/libri/project-nemesis/', amazon: 'https://www.amazon.com/dp/B0HNSMMM7J', discover: 'Discover the novel', buy: 'Buy on Amazon' },
];
const socials = [
  { name: 'Instagram', icon: 'instagram', url: 'https://www.instagram.com/cesarescalise.it/' },
  { name: 'Facebook', icon: 'facebook', url: 'https://www.facebook.com/cesare.scalise?locale=it_IT' },
  { name: 'Threads', icon: 'threads', url: 'https://www.threads.com/@cesarescalise.it' },
  { name: 'X', icon: 'x', url: 'https://x.com/cescali' },
  { name: 'LinkedIn', icon: 'linkedin', url: 'https://www.linkedin.com/in/cesare-scalise-0283858/' },
];
const personSchema = {
  '@context': 'https://schema.org', '@type': 'Person', '@id': 'https://www.cesarescalise.it/#person',
  name: 'Cesare Scalise', url: 'https://www.cesarescalise.it/',
  description: 'Autore italiano del techno-thriller Progetto Nemesis, sviluppatore software e appassionato di fotografia.',
  sameAs: socials.map(s => s.url), knowsAbout: ['Scrittura thriller', 'Techno-thriller', 'Sviluppo software', 'Fotografia'],
};
---
<BaseLayout home title="Sito ufficiale | Autore di Progetto Nemesis" description="Il sito ufficiale di Cesare Scalise, autore di Progetto Nemesis. Romanzi techno-thriller, tecnologia, articoli e fotografie di viaggio." image={italianCover}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  <div class="author-home">
    <BookCarousel editions={editions} />

    <section id="chi-sono" class="home-section introduction">
      <div><p class="eyebrow">01 / Chi sono</p><h2>La curiosità è il<br /><em>filo che unisce.</em></h2></div>
      <div class="introduction-copy">
        <p class="intro-lead">Sono Cesare Scalise. Scrivo codice, immagino storie e porto a casa fotografie.</p>
        <p>Il mio lavoro è l’informatica. Nei romanzi esploro il punto in cui tecnologia, spionaggio e azione si incontrano. Nei viaggi cerco luoghi e dettagli da raccontare attraverso le immagini.</p>
        <p>Questo spazio raccoglie le mie passioni: i libri, gli appunti dal mondo della tecnologia e le fotografie delle mie avventure.</p>
      </div>
    </section>

    <section id="libri" class="home-section">
      <div class="section-heading"><div><p class="eyebrow">02 / Libri</p><h2>Una storia.<br /><em>Due lingue.</em></h2></div><p>Spionaggio, tecnologia e azione.<br />Entra nel mondo di Nemesis.</p></div>
      <div class="edition-grid">
        {editions.map(edition => (
          <article class="edition-card">
            <a class="edition-cover" href={edition.page}><img src={edition.cover} alt={`Copertina di ${edition.title}`} width="663" height="1024" loading="lazy" /></a>
            <div><p class="eyebrow">{edition.language === 'it' ? 'Edizione italiana' : 'English edition'}</p><h3>{edition.title}</h3><p class="edition-tagline" lang={edition.language}>{edition.headline}</p><p>Spy · Action · Techno-thriller</p><a class="text-link" href={edition.page}>{edition.language === 'it' ? 'Sinossi e dettagli' : 'Read the synopsis'} <ArrowIcon /></a><a class="edition-amazon" href={edition.amazon} target="_blank" rel="noopener noreferrer">{edition.buy} <ArrowIcon /></a></div>
          </article>
        ))}
      </div>
    </section>

    <section id="blog" class="home-section">
      <div class="section-heading"><div><p class="eyebrow">03 / Dal blog</p><h2>Tra le righe,<br /><em>oltre il codice.</em></h2></div><a class="text-link" href="/blog/">Tutti gli articoli <ArrowIcon /></a></div>
      {posts.length > 0 ? <div class="home-posts">{posts.map(post => <PostCard post={post} />)}</div> : <p class="section-description">Gli articoli non sono disponibili in questo momento. <a class="text-link" href="/blog/">Vai al blog <ArrowIcon /></a></p>}
    </section>

    <section id="fotografia" class="home-section">
      <div class="section-heading"><div><p class="eyebrow">04 / Fotografia</p><h2>Il mondo,<br /><em>nel mio obiettivo.</em></h2></div><a class="text-link" href="/gallerie/">Tutte le gallerie <ArrowIcon /></a></div>
      <p class="section-description">Luoghi, viaggi e dettagli che meritano di essere ricordati. Un altro modo di raccontare storie.</p>
      {galleries.length > 0 ? <div class="home-galleries">{galleries.map(gallery => <GalleryCard gallery={gallery} />)}</div> : <a class="photo-invitation" href="/gallerie/"><span>Appunti di viaggio, in immagini.</span><span class="text-link">Esplora le gallerie <ArrowIcon /></span></a>}
    </section>

    <section id="profilo" class="home-section professional-section">
      <div><p class="eyebrow">05 / Profilo professionale</p><h2>La tecnologia,<br /><em>ogni giorno.</em></h2></div>
      <div class="introduction-copy"><p class="intro-lead">Senior Software Developer &amp; Team Leader.</p><p>Oltre 25 anni di esperienza nello sviluppo software. Applicazioni enterprise, coordinamento di team e una curiosità costante per gli strumenti e le possibilità dell’intelligenza artificiale.</p><a class="action action-secondary site-button site-button--outline" href="/cv/">Leggi il curriculum <ArrowIcon /></a></div>
    </section>

    <section id="contatti" class="home-section contact-section">
      <p class="eyebrow">06 / Restiamo in contatto</p><h2>Le storie continuano.<br /><em>Anche fuori da qui.</em></h2><p>Libri, tecnologia, fotografie e nuovi progetti: seguimi sui social.</p>
      <div class="social-links">{socials.map(s => (
        <a class="site-button site-button--outline" href={s.url} target="_blank" rel="noopener noreferrer" aria-label={s.name} title={s.name}>
          <img src={`https://cdn.jsdelivr.net/npm/simple-icons@v13/icons/${s.icon}.svg`} alt="" width="20" height="20" loading="lazy" />
        </a>
      ))}</div>
    </section>
  </div>
</BaseLayout>
