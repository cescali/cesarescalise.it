---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import GalleryCard from '../components/GalleryCard.astro';
import { getPosts } from '../lib/wordpress';
import { getFolders } from '../lib/cloudinary';

const [posts, galleries] = await Promise.all([
  getPosts(6),
  getFolders(),
]);

const latestGalleries = galleries.slice(0, 3);
---

<BaseLayout title="Home">

  <!-- Hero -->
  <section class="bg-gradient-to-br from-gray-950 via-gray-900 to-gray-950 text-white py-28 px-5">
    <div class="max-w-6xl mx-auto text-center">
      <p class="text-orange-400 font-semibold text-sm uppercase tracking-widest mb-5">Benvenuto nel mio spazio</p>
      <h1 class="font-display text-5xl sm:text-6xl lg:text-7xl font-bold mb-6 leading-tight">
        Ciao, sono<br/>
        <span class="text-orange-400">Cesare Scalise</span>
      </h1>
      <p class="text-lg text-gray-300 max-w-2xl mx-auto mb-10 leading-relaxed">
        Scrivo del mio lavoro, delle mie passioni e condivido foto dei miei viaggi e avventure.
      </p>
      <div class="flex gap-4 justify-center flex-wrap">
        <a href="/blog"
           class="px-7 py-3 bg-orange-500 hover:bg-orange-600 text-white rounded-xl font-semibold transition-colors shadow-lg">
          Leggi il blog
        </a>
        <a href="/gallerie"
           class="px-7 py-3 border-2 border-white/30 hover:border-orange-400 hover:text-orange-400 text-white rounded-xl font-semibold transition-colors">
          Gallerie foto
        </a>
        <a href="/cv"
           class="px-7 py-3 border-2 border-white/30 hover:border-orange-400 hover:text-orange-400 text-white rounded-xl font-semibold transition-colors">
          Il mio CV
        </a>
      </div>
    </div>
  </section>

  <!-- Ultimi articoli -->
  <section class="max-w-6xl mx-auto px-5 py-16">
    <div class="flex items-end justify-between mb-10">
      <div>
        <p class="text-orange-500 text-sm font-semibold uppercase tracking-widest mb-1">Dal blog</p>
        <h2 class="font-display text-3xl sm:text-4xl font-bold">Ultimi articoli</h2>
      </div>
      <a href="/blog" class="text-sm font-semibold text-gray-400 hover:text-orange-500 transition-colors hidden sm:block">
        Tutti gli articoli →
      </a>
    </div>
    {posts.length === 0 ? (
      <p class="text-gray-400">Nessun articolo trovato.</p>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map(post => <PostCard post={post} />)}
      </div>
    )}
    <div class="mt-8 sm:hidden">
      <a href="/blog" class="text-sm font-semibold text-orange-500">Tutti gli articoli →</a>
    </div>
  </section>

  <!-- Gallerie -->
  {latestGalleries.length > 0 && (
    <section class="bg-gray-50 py-16 px-5">
      <div class="max-w-6xl mx-auto">
        <div class="flex items-end justify-between mb-10">
          <div>
            <p class="text-orange-500 text-sm font-semibold uppercase tracking-widest mb-1">Fotografia</p>
            <h2 class="font-display text-3xl sm:text-4xl font-bold">Gallerie</h2>
          </div>
          <a href="/gallerie" class="text-sm font-semibold text-gray-400 hover:text-orange-500 transition-colors hidden sm:block">
            Tutte le gallerie →
          </a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {latestGalleries.map(g => <GalleryCard gallery={g} />)}
        </div>
      </div>
    </section>
  )}

</BaseLayout>
