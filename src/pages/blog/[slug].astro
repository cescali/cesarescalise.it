---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPost, formatDate, getFeaturedImage } from '../../lib/wordpress';

const { slug } = Astro.params;
const post = await getPost(slug!);

if (!post) {
  return Astro.redirect('/blog');
}

const image = getFeaturedImage(post);
---

<BaseLayout
  title={post.title.rendered}
  description={post.excerpt?.rendered?.replace(/<[^>]*>/g, '').trim().slice(0, 160)}
  image={image ?? undefined}
>

  <article class="max-w-2xl mx-auto">

    <!-- Back -->
    <a href="/blog" class="inline-flex items-center gap-1 text-sm text-gray-400 hover:text-blue-600 transition-colors mb-8">
      ← Torna al blog
    </a>

    <!-- Header -->
    <header class="mb-8">
      <time class="text-sm text-gray-400 mb-3 block">{formatDate(post.date)}</time>
      <h1 class="text-3xl sm:text-4xl font-bold leading-tight mb-4" set:html={post.title.rendered} />
    </header>

    <!-- Featured image -->
    {image && (
      <img
        src={image}
        alt={post.title.rendered}
        class="w-full rounded-xl shadow-sm mb-10 aspect-video object-cover"
      />
    )}

    <!-- Content -->
    <div class="wp-content" set:html={post.content.rendered} />

  </article>

</BaseLayout>
