---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPost, formatDate, getFeaturedImage } from '../../lib/wordpress';

const { slug } = Astro.params;
const post = await getPost(slug!);

if (!post) {
  return Astro.redirect('/blog');
}

const image = getFeaturedImage(post);
---

<BaseLayout
  title={post.title.rendered}
  description={post.excerpt?.rendered?.replace(/<[^>]*>/g, '').trim().slice(0, 160)}
  image={image ?? undefined}
>

  <!-- Hero: immagine in evidenza o barra dark -->
  {image ? (
    <div class="w-full aspect-[21/9] max-h-[480px] overflow-hidden bg-gray-900">
      <img src={image} alt={post.title.rendered} class="w-full h-full object-cover opacity-80" />
    </div>
  ) : (
    <div class="w-full h-24 bg-gray-950" />
  )}

  <div class="max-w-3xl mx-auto px-5 py-12">

    <a href="/blog" class="inline-flex items-center gap-2 text-sm text-gray-400 hover:text-indigo-600 transition-colors mb-8 group">
      <span class="group-hover:-translate-x-1 transition-transform inline-block">←</span>
      Torna al blog
    </a>

    <header class="mb-10">
      <time class="text-sm font-semibold text-indigo-600 mb-3 block">{formatDate(post.date)}</time>
      <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold leading-tight" set:html={post.title.rendered} />
    </header>

    <div class="wp-content" set:html={post.content.rendered} />

  </div>

</BaseLayout>
