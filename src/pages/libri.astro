---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPage } from '../lib/wordpress';

const page = await getPage('libri');

interface Book {
  titleHtml: string;
  taglineHtml: string;
  coverSrc: string;
  coverAlt: string;
  descriptionHtml: string;
}

// Il contenuto WordPress è un blocco "media-text" (copertina + testo).
// Lo estraiamo per costruire un layout a due colonne su misura, invece di
// affidarci agli stili CSS nativi di WordPress (non caricati su questo sito).
function extractBooks(html: string): Book[] {
  const books: Book[] = [];
  const blockRegex = /<h2[^>]*>([\s\S]*?)<\/h2>\s*<p>([\s\S]*?)<\/p>\s*<div class="wp-block-media-text[^"]*">([\s\S]*?)<\/div>\s*<\/div>/g;
  let match: RegExpExecArray | null;
  while ((match = blockRegex.exec(html))) {
    const [, titleHtml, taglineHtml, mediaInner] = match;

    const figureMatch = mediaInner.match(/<figure[^>]*>([\s\S]*?)<\/figure>/);
    const figureHtml = figureMatch?.[1] ?? '';
    const imgTagMatch = figureHtml.match(/<img\b[^>]*>/);
    let coverSrc = '';
    let coverAlt = '';
    if (imgTagMatch) {
      coverSrc = imgTagMatch[0].match(/src="([^"]+)"/)?.[1] ?? '';
      coverAlt = imgTagMatch[0].match(/alt="([^"]*)"/)?.[1] ?? '';
    }

    const contentIdx = mediaInner.indexOf('wp-block-media-text__content');
    let descriptionHtml = '';
    if (contentIdx !== -1) {
      const tagEnd = mediaInner.indexOf('>', contentIdx) + 1;
      descriptionHtml = mediaInner.slice(tagEnd).trim();
    }

    books.push({ titleHtml, taglineHtml, coverSrc, coverAlt, descriptionHtml });
  }
  return books;
}

const books = page ? extractBooks(page.content.rendered) : [];
---

<BaseLayout title="Libri" description="I libri di Cesare Scalise">

  <div class="max-w-5xl xl:max-w-6xl mx-auto px-5 py-6 lg:py-8 lg:h-[calc(100vh-170px)] lg:flex lg:flex-col">
    <p class="text-indigo-600 text-xs font-semibold uppercase tracking-widest mb-4 shrink-0">Libri</p>

    {books.length > 0 ? (
      books.map(book => (
        <article class="flex flex-col lg:flex-row gap-6 lg:gap-10 lg:flex-1 lg:min-h-0 mb-10 lg:mb-0">
          <div class="shrink-0 w-full sm:w-64 lg:w-72 xl:w-80 mx-auto lg:mx-0">
            <img
              src={book.coverSrc}
              alt={book.coverAlt || 'Copertina del libro'}
              class="rounded-lg shadow-lg object-contain w-full h-auto max-h-[45vh] lg:max-h-full mx-auto"
            />
          </div>
          <div class="libri-desc min-w-0 lg:flex-1 lg:overflow-y-auto lg:pr-2">
            <h1 class="font-display text-2xl sm:text-3xl font-bold text-gray-900 mb-2" set:html={book.titleHtml} />
            <p class="text-gray-600 italic text-sm sm:text-base mb-4" set:html={book.taglineHtml} />
            <div class="wp-content text-sm sm:text-base leading-snug" set:html={book.descriptionHtml} />
          </div>
        </article>
      ))
    ) : (
      <p class="text-gray-400">Nessun contenuto disponibile al momento.</p>
    )}
  </div>

</BaseLayout>

<style>
  .libri-desc :global(p) {
    margin-bottom: 0.6rem;
  }
  .libri-desc :global(a) {
    color: #4f46e5;
    text-decoration: underline;
  }
</style>
