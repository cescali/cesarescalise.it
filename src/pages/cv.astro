---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPage } from '../lib/wordpress';

const page = await getPage('cv');
---

<BaseLayout title="Curriculum Vitae">

  <div class="bg-gray-950 text-white py-16 px-5">
    <div class="max-w-3xl mx-auto">
      <p class="text-indigo-500 text-sm font-semibold uppercase tracking-widest mb-3">Profilo</p>
      <h1 class="font-display text-4xl sm:text-5xl font-bold">Curriculum Vitae</h1>
    </div>
  </div>

  <div class="max-w-3xl mx-auto px-5 py-14">

    {page ? (
      <div class="wp-content" set:html={page.content.rendered} />
    ) : (
      <div class="space-y-8">

        <section>
          <h2 class="text-xl font-semibold text-indigo-600 border-b border-orange-100 pb-2 mb-4">Chi sono</h2>
          <p class="text-gray-600 leading-relaxed">
            Cesare Scalise. Aggiorna questa sezione modificando la pagina "cv" in WordPress,
            oppure modificando direttamente questo file.
          </p>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-indigo-600 border-b border-orange-100 pb-2 mb-4">Esperienze</h2>
          <p class="text-gray-400 text-sm">Aggiungi le tue esperienze lavorative in WordPress.</p>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-indigo-600 border-b border-orange-100 pb-2 mb-4">Formazione</h2>
          <p class="text-gray-400 text-sm">Aggiungi la tua formazione in WordPress.</p>
        </section>

        <div class="mt-8 pt-6 border-t border-gray-100">
          <a
            href="/documenti/CVCesareA.doc"
            class="inline-flex items-center gap-2 px-6 py-3 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-semibold transition-colors shadow-lg"
            download
          >
            📄 Scarica CV (DOC)
          </a>
        </div>

      </div>
    )}

  </div>

</BaseLayout>
