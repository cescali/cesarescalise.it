---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPage } from '../lib/wordpress';

const page = await getPage('cv');
---

<BaseLayout title="Curriculum Vitae">

  <div class="max-w-2xl mx-auto">

    <h1 class="text-3xl font-bold mb-8">Curriculum Vitae</h1>

    {page ? (
      <div class="wp-content" set:html={page.content.rendered} />
    ) : (
      <!-- Fallback CV statico se la pagina WP non esiste -->
      <div class="space-y-8">

        <section>
          <h2 class="text-xl font-semibold text-blue-600 border-b border-blue-100 pb-2 mb-4">Chi sono</h2>
          <p class="text-gray-600 leading-relaxed">
            Cesare Scalise. Aggiorna questa sezione modificando la pagina "cv" in WordPress,
            oppure modificando direttamente questo file.
          </p>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-blue-600 border-b border-blue-100 pb-2 mb-4">Esperienze</h2>
          <p class="text-gray-400 text-sm">Aggiungi le tue esperienze lavorative in WordPress.</p>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-blue-600 border-b border-blue-100 pb-2 mb-4">Formazione</h2>
          <p class="text-gray-400 text-sm">Aggiungi la tua formazione in WordPress.</p>
        </section>

        <div class="mt-8 pt-6 border-t border-gray-100">
          <a
            href="/documenti/CVCesareA.doc"
            class="inline-flex items-center gap-2 px-5 py-2.5 bg-blue-600 text-white rounded-lg font-medium hover:bg-blue-700 transition-colors"
            download
          >
            📄 Scarica CV (DOC)
          </a>
        </div>

      </div>
    )}

  </div>

</BaseLayout>
