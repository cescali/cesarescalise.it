---
import '../styles/global.css';
import '../styles/palette-preview.css';
import '../styles/buttons.css';
import Analytics from '@vercel/analytics/astro';
import PalettePreview from '../components/PalettePreview.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import ApplicationsMenu from '../components/ApplicationsMenu.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  home?: boolean;
  lang?: 'it' | 'en';
  languageAlternates?: { lang: string; path: string }[];
}

const { title, description = 'Il sito personale di Cesare Scalise — blog, gallerie e curriculum', image, lang = 'it', languageAlternates = [], home = false } = Astro.props;
const isEnglish = lang === 'en';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const navLinks: { href: string; label: string; external?: boolean; applications?: boolean }[] = home ? [
  { href: '#chi-sono', label: 'Chi sono' },
  { href: '#libri', label: 'Libri' },
  { href: '#blog', label: 'Blog' },
  { href: '#fotografia', label: 'Fotografia' },
  { href: '#profilo', label: 'Profilo' },
  { href: '#progetti', label: 'Progetti' },
  { href: '#applicazioni', label: isEnglish ? 'Applications' : 'Applicazioni', applications: true },
  { href: '#contatti', label: 'Contatti' },
] : [
  { href: '/blog',     label: 'Blog' },
  { href: '/gallerie', label: isEnglish ? 'Galleries' : 'Gallerie' },
  { href: '/libri',    label: isEnglish ? 'Books' : 'Libri' },
  { href: '/cv',       label: 'CV' },
  { href: '#applicazioni', label: isEnglish ? 'Applications' : 'Applicazioni', applications: true },
];
const applications = [
  { href: 'https://candywolf.store/', label: 'CandyWolf.store' },
  { href: 'https://vaitorino.vercel.app/', label: 'VaiTorino' },
  { href: 'https://meteo-piemonte.vercel.app/', label: 'Meteo Piemonte' },
];
const currentPath = Astro.url.pathname;
const homePath = isEnglish ? '/en/' : '/';
const pageAlternates = languageAlternates.length ? languageAlternates : [{ lang: 'it', path: '/' }, { lang: 'en', path: '/en/' }];
const homeLabels: Record<string, string> = { 'Chi sono': 'About me', 'Libri': 'Books', 'Fotografia': 'Photography', 'Profilo': 'Profile', 'Progetti': 'Projects', 'Contatti': 'Contact', 'Meteo Piemonte': 'Piedmont Weather' };
if (isEnglish && home) navLinks.forEach(link => { link.label = homeLabels[link.label] ?? link.label; });
if (isEnglish && !home) navLinks.forEach(link => {
  if (link.href === '/libri') link.href = '/libri/project-nemesis/';
  if (link.href === '/blog' || link.href === '/gallerie' || link.href === '/cv') link.label += ' (IT)';
});
---

<!doctype html>
<html lang={lang} data-preview-palette="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title} — Cesare Scalise</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {languageAlternates.map(alternate => (
      <link rel="alternate" hreflang={alternate.lang} href={new URL(alternate.path, Astro.site).href} />
    ))}
    {languageAlternates.length > 0 && <link rel="alternate" hreflang="x-default" href={new URL(languageAlternates.find(a => a.lang === 'it')?.path ?? '/', Astro.site).href} />}

    <meta property="og:title" content={`${title} — Cesare Scalise`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:locale" content={isEnglish ? 'en_US' : 'it_IT'} />
    <meta property="og:site_name" content="Cesare Scalise" />
    
    {image && (
      <meta property="og:image" content={new URL(image, Astro.site).href} />
    )}
    
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={`${title} — Cesare Scalise`} />
    <meta name="twitter:description" content={description} />
    {image && (
      <meta name="twitter:image" content={new URL(image, Astro.site).href} />
    )}

    {import.meta.env.DEV && (
      <script is:inline>
        try {
          const choice = sessionStorage.getItem('cesare-preview-palette');
          document.documentElement.dataset.previewPalette = ['medium', 'dark'].includes(choice) ? choice : 'dark';
        } catch { document.documentElement.dataset.previewPalette = 'dark'; }
      </script>
    )}
    <!-- Google Fonts: Inter (body) + Playfair Display (headings) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@700;800&display=swap" rel="stylesheet" />

    <!-- GLightbox CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/glightbox/dist/css/glightbox.min.css" />
  </head>
  <body class="bg-canvas text-gray-900 antialiased font-sans">

    <!-- Navbar -->
    <header class:list={["sticky top-0 z-50 bg-canvas border-b border-gray-200 shadow-sm", { "author-header": home }]}>
      <nav class="max-w-6xl mx-auto px-5 py-4 flex items-center justify-between">
        <a href={homePath} class="font-display text-xl font-bold text-gray-900 hover:text-brand-600 transition-colors tracking-wide">
          Cesare Scalise
        </a>
        <ul class:list={[home ? "hidden xl:flex" : "hidden sm:flex", "gap-5 text-sm font-medium"]}>
          {navLinks.map(link => (
            <li>
              {link.applications ? <ApplicationsMenu label={link.label} applications={applications} isEnglish={isEnglish} /> : (
              <a
                href={link.href}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
                class={`transition-colors pb-0.5 ${
                  !link.external && currentPath.startsWith(link.href)
                    ? 'text-brand-600 border-b-2 border-brand-600'
                    : 'text-gray-600 hover:text-brand-600'
                }`}
              >
                {link.label}{link.external && <> <ArrowIcon /></>}
              </a>
              )}
            </li>
          ))}
        </ul>

        <nav class="language-switcher" aria-label={isEnglish ? 'Website language' : 'Lingua del sito'}>
          {pageAlternates.map(alternate => (
            <a href={alternate.path} lang={alternate.lang} hreflang={alternate.lang} aria-current={alternate.lang === lang ? 'page' : undefined} aria-label={alternate.lang === 'it' ? 'Italiano' : 'English'}>{alternate.lang.toUpperCase()}</a>
          ))}
        </nav>
        <!-- Hamburger (solo mobile) -->
        <button
          id="menu-toggle"
          type="button"
          aria-label={isEnglish ? 'Open menu' : 'Apri menu'}
          aria-expanded="false"
          aria-controls="mobile-menu"
          class:list={[home ? "xl:hidden home-menu-toggle" : "sm:hidden", "site-button site-button--outline p-2 -mr-2 text-gray-700"]}
        >
          <svg id="icon-open" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </nav>

      <!-- Menu mobile a tendina -->
      <ul id="mobile-menu" class:list={["hidden flex-col px-5 pb-4 text-sm font-medium border-t border-gray-200", home ? "xl:hidden" : "sm:hidden"]}>
        {navLinks.map(link => (
          <li>
            {link.applications ? <ApplicationsMenu label={link.label} applications={applications} isEnglish={isEnglish} mobile /> : (
            <a
              href={link.href}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
              class={`block py-3 ${
                !link.external && currentPath.startsWith(link.href)
                  ? 'text-brand-600 font-semibold'
                  : 'text-gray-600'
              }`}
            >
              {link.label}{link.external && <> <ArrowIcon /></>}
            </a>
            )}
          </li>
        ))}
      </ul>
    </header>

    <script>
      const toggle = document.getElementById('menu-toggle');
      const menu = document.getElementById('mobile-menu');
      const iconOpen = document.getElementById('icon-open');
      const iconClose = document.getElementById('icon-close');

      menu?.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          menu.classList.add('hidden');
          iconOpen?.classList.remove('hidden');
          iconClose?.classList.add('hidden');
          toggle?.setAttribute('aria-expanded', 'false');
        });
      });

      toggle?.addEventListener('click', () => {
        const isOpen = !menu?.classList.contains('hidden');
        menu?.classList.toggle('hidden');
        iconOpen?.classList.toggle('hidden');
        iconClose?.classList.toggle('hidden');
        toggle.setAttribute('aria-expanded', String(!isOpen));
      });
    </script>

    <main class="min-h-[calc(100vh-130px)]">
      <slot />
    </main>

    <footer class:list={["bg-canvas border-t border-gray-200 text-gray-500", home ? "mt-0" : "mt-20"]}>
      <div class="max-w-6xl mx-auto px-5 py-10 flex flex-col sm:flex-row items-center justify-between gap-4">
        <span class="font-display text-gray-900 font-bold text-lg">Cesare Scalise</span>
        <nav class="flex flex-wrap justify-center gap-x-6 gap-y-3 text-sm">
          {navLinks.filter(link => !link.applications).map(link => (
            <a
              href={link.href}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
              class="hover:text-brand-600 transition-colors"
            >
              {link.label}{link.external && <> <ArrowIcon /></>}
            </a>
          ))}
        </nav>
        <p class="text-xs">© {new Date().getFullYear()} Cesare Scalise</p>
      </div>
    </footer>
	
	<Analytics />
    {import.meta.env.DEV && <PalettePreview />}

  </body>
</html>
